<%= content_for :title, "Live Endpoints" %>

<div class="mx-auto max-w-3xl space-y-8">
  <header class="space-y-4 border-b border-edge-default pb-4">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-content-strong">Live endpoints</h1>
        <p class="mt-2 text-content-muted">已驗證、正在線上服務的唯讀 API 端點。</p>
      </div>
      <span class="shrink-0 font-mono text-sm text-content-muted"><%= pluralize(@endpoints.size, "endpoint") %></span>
    </div>

    <%# Operator control panel — demo tooling. "Inject events" writes a fresh
        batch through ActiveRecord (not the sandbox) so an already-live endpoint
        visibly changes on its next request. "Reset" clears the whole board back
        to the fresh-demo state (guarded by a confirm). %>
    <div class="flex flex-wrap gap-3">
      <%= button_to "灌入一批事件", demo_events_path, method: :post,
                    class: "inline-flex items-center border border-edge-strong bg-surface-raised px-4 py-2 text-sm font-medium text-content-strong transition-colors hover:bg-surface-sunken focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary" %>
      <% if @endpoints.any? %>
        <%= button_to "清空全部端點", reset_endpoints_path, method: :delete,
                      form: { data: { turbo_confirm: "確定清空所有端點？此動作無法復原（事件資料保留）。" } },
                      class: "inline-flex items-center border border-danger/45 bg-surface-raised px-4 py-2 text-sm font-medium text-danger transition-colors hover:bg-danger/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-danger" %>
      <% end %>
    </div>
  </header>

  <% if @endpoints.any? %>
    <ul class="space-y-4">
      <% @endpoints.each do |endpoint| %>
        <li class="border border-edge-default bg-surface-raised p-5">
          <div class="flex items-baseline justify-between gap-4">
            <%= link_to dynamic_endpoint_path(endpoint.slug),
                        class: "break-all font-mono text-sm font-medium text-primary underline decoration-edge-strong underline-offset-2 hover:decoration-primary" do %>/e/<%= endpoint.slug %><% end %>
            <time class="shrink-0 font-mono text-xs text-content-muted" datetime="<%= endpoint.created_at.iso8601 %>">
              <%= endpoint.created_at.strftime("%Y-%m-%d %H:%M") %>
            </time>
          </div>
          <% if endpoint.generation_request&.requirement.present? %>
            <p class="mt-2 text-content-default"><%= endpoint.generation_request.requirement %></p>
          <% end %>
          <pre class="mt-3 max-h-40 overflow-auto border border-edge-subtle bg-surface-sunken p-3 font-mono text-xs leading-relaxed text-content-default"><%= endpoint.script %></pre>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="border border-edge-default bg-surface-raised p-8 text-center">
      <p class="font-mono text-sm text-content-muted">No endpoints yet.</p>
      <p class="mt-2 text-content-default">尚未生成任何端點。先描述一份報表，讓沙盒幫你生成第一個。</p>
      <%= link_to "Generate your first endpoint", new_endpoint_path,
                  class: "mt-4 inline-flex items-center bg-primary px-5 py-3 text-sm font-semibold text-content-inverse transition-colors hover:bg-primary-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary" %>
    </div>
  <% end %>
</div>
