<%#
  Status partial — rendered inside the Turbo Frame on show.
  Three states, each with three signals (colour + icon + label) so they read
  on a projector and for colour-blind viewers.

  data-generation-finished marks the two terminal panels (succeeded / failed).
  It is the single sentinel the Generation log keys off (via :has() in
  show.html.erb) to drop its bounded scroll height once the run is over, so the
  finished record reads top-to-bottom as a normal document instead of inside a
  squeezed live-streaming window. Pending carries no sentinel.

  #13 replaces this partial via:
    Turbo::StreamsChannel.broadcast_replace_to(
      generation_request,
      target: dom_id(generation_request),
      partial: "endpoints/status",
      locals: { generation_request: generation_request }
    )
%>
<% if generation_request.pending? %>
  <div class="flex items-center gap-3 border border-warning/45 bg-warning/10 p-4">
    <span class="h-4 w-4 shrink-0 animate-spin rounded-full border-2 border-warning border-t-transparent motion-reduce:animate-none" aria-hidden="true"></span>
    <p class="text-sm font-medium text-content-strong">Generating endpoint… 沙盒驗證中，請稍候。</p>
  </div>

<% elsif generation_request.succeeded? %>
  <div data-generation-finished class="space-y-3 border border-success/45 bg-success/10 p-4">
    <div class="flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-success" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
        <path d="M4 10.5l4 4 8-9" />
      </svg>
      <p class="text-sm font-semibold text-content-strong">Endpoint generated — now live.</p>
    </div>
    <% if generation_request.endpoint.present? %>
      <div>
        <p class="mb-1 text-sm font-medium text-content-muted">Endpoint URL</p>
        <%= link_to dynamic_endpoint_url(generation_request.endpoint.slug),
                    dynamic_endpoint_path(generation_request.endpoint.slug),
                    class: "inline-block break-all bg-surface-sunken px-2 py-1 font-mono text-sm text-primary underline decoration-edge-strong underline-offset-2 hover:decoration-primary" %>
      </div>
      <div>
        <p class="mb-1 text-sm font-medium text-content-muted">Script</p>
        <pre class="max-h-40 overflow-auto border border-edge-default bg-surface-sunken p-3 font-mono text-xs leading-relaxed text-content-default"><%= generation_request.endpoint.script %></pre>
      </div>
      <p>
        <%= link_to "View all live endpoints →", endpoints_path, class: "font-mono text-sm text-primary underline underline-offset-2 hover:no-underline" %>
      </p>
    <% end %>
  </div>

<% elsif generation_request.failed? %>
  <div data-generation-finished class="space-y-2 border border-danger/45 bg-danger/10 p-4">
    <div class="flex items-center gap-2">
      <svg class="h-4 w-4 shrink-0 text-danger" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" />
      </svg>
      <p class="text-sm font-semibold text-content-strong">Generation failed.</p>
    </div>
    <% if generation_request.error_message.present? %>
      <p class="font-mono text-sm text-content-default"><%= generation_request.error_message %></p>
    <% end %>
    <p>
      <%= link_to "Try again", new_endpoint_path, class: "font-mono text-sm text-primary underline underline-offset-2 hover:no-underline" %>
    </p>
  </div>

<% end %>
