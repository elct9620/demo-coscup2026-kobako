<%#
  Status partial — rendered inside the Turbo Frame on show.
  #13 can replace this partial via:
    Turbo::StreamsChannel.broadcast_replace_to(
      generation_request,
      target: dom_id(generation_request),
      partial: "endpoints/status",
      locals: { generation_request: generation_request }
    )
%>
<% if generation_request.pending? %>
  <div class="flex items-center gap-3 rounded-md bg-yellow-50 border border-yellow-200 p-4">
    <div class="h-4 w-4 animate-spin rounded-full border-2 border-yellow-500 border-t-transparent"></div>
    <p class="text-sm text-yellow-800 font-medium">Generating endpoint… this may take a moment.</p>
  </div>

<% elsif generation_request.succeeded? %>
  <div class="rounded-md bg-green-50 border border-green-200 p-4 space-y-3">
    <p class="text-sm text-green-800 font-semibold">Endpoint generated successfully.</p>
    <% if generation_request.endpoint.present? %>
      <div>
        <p class="text-sm text-gray-500 mb-1">Endpoint URL</p>
        <%= link_to dynamic_endpoint_url(generation_request.endpoint.slug),
                    dynamic_endpoint_path(generation_request.endpoint.slug),
                    class: "text-sm font-mono text-indigo-700 hover:underline break-all" %>
      </div>
      <div>
        <p class="text-sm text-gray-500 mb-1">Script</p>
        <pre class="text-xs bg-white border border-gray-200 rounded p-3 overflow-x-auto"><%= generation_request.endpoint.script %></pre>
      </div>
    <% end %>
  </div>

<% elsif generation_request.failed? %>
  <div class="rounded-md bg-red-50 border border-red-200 p-4 space-y-2">
    <p class="text-sm text-red-800 font-semibold">Generation failed.</p>
    <% if generation_request.error_message.present? %>
      <p class="text-sm text-red-700"><%= generation_request.error_message %></p>
    <% end %>
    <p class="text-sm text-gray-600">
      <%= link_to "Try again", new_endpoint_path, class: "text-indigo-600 hover:text-indigo-800" %>
    </p>
  </div>

<% end %>
