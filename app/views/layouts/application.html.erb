<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <title><%= content_for(:title) || "Dynamic Read-Only API" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dynamic Read-Only API">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Fonts: Jost (geometric display/body) + JetBrains Mono (machine layer).
        CJK falls back to the system face (PingFang / Noto) via --font-sans. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-surface-base font-sans text-content-default antialiased">
    <header class="border-b border-edge-default bg-surface-raised">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4">
        <%= link_to root_path, class: "group inline-flex items-baseline gap-2 no-underline" do %>
          <span class="font-semibold tracking-tight text-content-strong">Dynamic Read-Only API</span>
          <span class="font-mono text-xs text-content-muted">/ generator</span>
        <% end %>
        <nav class="flex items-center gap-5 font-mono text-sm">
          <%= link_to "Generate", new_endpoint_path, class: "text-content-muted hover:text-content-strong" %>
          <%= link_to "Endpoints", endpoints_path, class: "text-content-muted hover:text-content-strong" %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-5 py-12 sm:py-16">
      <%= yield %>
    </main>
  </body>
</html>
