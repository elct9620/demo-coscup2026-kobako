<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <title><%= content_for(:title) || "Dynamic Read-Only API" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Dynamic Read-Only API">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Fonts: Jost (geometric display/body) + JetBrains Mono (machine layer).
        CJK falls back to the system face (PingFang / Noto) via --font-sans.
        Loaded non-render-blocking (media=print → all on load) so a flaky
        venue network can never stall first paint: text shows immediately in
        the fallback face and swaps to Jost/Mono once the sheet arrives. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
          media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
    </noscript>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# Flex column pinned to the viewport height (dvh adapts to any screen and to
      mobile browser chrome). The header keeps its natural size and <main> flexes
      to fill the rest. Pages that fill the height give an inner panel a definite
      bound to scroll within (the generation log); pages that overflow (long
      index lists) simply scroll the document as usual. %>
  <body class="flex h-dvh flex-col bg-surface-base font-sans text-content-default antialiased">
    <header class="border-b border-edge-default bg-surface-raised">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4">
        <%= link_to root_path, class: "group inline-flex items-baseline gap-2 no-underline" do %>
          <span class="font-semibold tracking-tight text-content-strong">Dynamic Read-Only API</span>
          <span class="font-mono text-xs text-content-muted">/ generator</span>
        <% end %>
        <% nav_idle = "text-content-muted hover:text-content-strong" %>
        <nav class="flex items-center gap-5 font-mono text-sm">
          <%= link_to "Generate", new_endpoint_path,
                      class: action_name.in?(%w[new create]) ? "text-content-strong" : nav_idle,
                      aria: { current: action_name.in?(%w[new create]) ? "page" : nil } %>
          <%= link_to "Endpoints", endpoints_path,
                      class: action_name == "index" ? "text-content-strong" : nav_idle,
                      aria: { current: action_name == "index" ? "page" : nil } %>
        </nav>
      </div>
    </header>

    <main class="mx-auto flex w-full min-h-0 max-w-5xl flex-1 flex-col px-5 py-12 sm:py-16">
      <%= yield %>
    </main>
  </body>
</html>
